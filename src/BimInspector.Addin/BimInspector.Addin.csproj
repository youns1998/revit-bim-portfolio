<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><TargetFramework>net8.0-windows</TargetFramework><UseWPF>true</UseWPF></PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../BimInspector.Core/BimInspector.Core.csproj" />
    <ProjectReference Include="../BimInspector.UI/BimInspector.UI.csproj" />
    <Reference Include="RevitAPI"><HintPath>$(RevitInstallDir)\RevitAPI.dll</HintPath><Private>false</Private><ExternallyResolved>true</ExternallyResolved></Reference>
    <Reference Include="RevitAPIUI"><HintPath>$(RevitInstallDir)\RevitAPIUI.dll</HintPath><Private>false</Private><ExternallyResolved>true</ExternallyResolved></Reference>
  </ItemGroup>
  <Target Name="CheckRevitApi" BeforeTargets="ResolveReferences" Condition="!Exists('$(RevitInstallDir)\RevitAPI.dll')">
    <Error Text="Revit 2026 API가 없습니다. -p:RevitInstallDir=설치경로 를 지정하세요." />
  </Target>
</Project>
